*.db-shm

# mygo UI headless render output (written when MYGO_UI_PNG is set for
# visual verification — not project source).
src/app/render-out/

# Go toolchain auto-download
go.work

# Upstream reference clones (not part of this repo). mygo is consumed as a
# normal Go module (github.com/egoist/mygo, pinned in go.mod/go.sum and fetched
# over git), so this clone is only a local reference — not needed to build.
/_upstream/*

# Node
node_modules/
dist/
unpackage/

# Agent workspace data (local notes / caches, not project source)
.workbuddy-ai/

# IDE / OS
.DS_Store
.idea/
.vscode/
*.log
