{
  "name": "GoCode",
  "identifier": "net.spacering.gocode",
  "version": "0.1.0",
  "main": "./cmd/gocode",
  "out": "build/app",
  "i18n": { "dir": "locales", "source": "en" },
  "fileAssociations": [
    { "ext": ["md", "markdown"], "name": "Markdown Document", "mimeType": "text/markdown" },
    { "ext": ["txt"], "name": "Plain Text", "mimeType": "text/plain" }
  ]
}
